<Project Sdk="Microsoft.NET.Sdk">

  <!-- The engine: ACP, the converter, the row store, the live hub, sessions and the API routes. No UI and no
       Mac code. The Mac host and the remote host each use it; neither host's code ships in the other. -->
  <PropertyGroup>
    <!-- Native AOT is measured in step 4; until then the analyzers keep the code AOT-safe. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assembly.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel and WebSockets for the API (step 3). Part of the .NET runtime, so no package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
