          "function": {
            "color": "#ffdd00"
          },
          "property": {
            "color": "#80ffbb"
          },
          "type": {
            "color": "#80ffbb"
          },
          "constructor": {
            "color": "#ffdd00"
          },
          "tag": {
            "color": "#80ffbb"
          },
          "attribute": {
            "color": "#9effff"
          },
          "label": {
            "color": "#ffdd00"
          },
          "operator": {
            "color": "#ff9d00"
          },
          "punctuation.special": {
            "color": "#edef7d"
