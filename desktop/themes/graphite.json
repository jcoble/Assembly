            "color": "#acafff"
          },
          "tag": {
            "color": "#acafff"
          },
          "attribute": {
            "color": "#4bf3c8"
          },
          "label": {
            "color": "#4bf3c8"
          },
          "operator": {
            "color": "#eef0f9"
