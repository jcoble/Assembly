{
  "$schema": "https://github.com/longbridge/gpui-kit/raw/refs/heads/main/.theme-schema.json",
  "name": "Amy",
  "author": "Assembly (ported from mac-command-bar)",
  "themes": [
    {
      "is_default": false,
      "name": "Amy",
      "mode": "dark",
      "font.size": 13.0,
      "mono_font.size": 12.0,
      "radius": 8,
      "radius.lg": 16,
      "shadow": false,
      "colors": {
        "background": "#121212",
        "foreground": "#d9d9d9",
        "border": "#ffffff1a",
        "accent.background": "#1f1f1f",
        "accent.foreground": "#ececec",
        "accordion.background": "#121212",
        "group_box.background": "#1c1c1c",
        "group_box.foreground": "#d9d9d9",
        "caret": "#8b93ff",
        "danger.background": "#ec8b86",
        "danger.foreground": "#121212",
        "success.background": "#7fdcb0",
        "success.foreground": "#121212",
        "warning.background": "#e6c97e",
        "warning.foreground": "#121212",
        "info.background": "#7ec8ff",
        "info.foreground": "#121212",
        "drag.border": "#8b93ff",
        "drop_target.background": "#8b93ff1f",
        "input.border": "#ffffff1a",
        "ring": "#8b93ff59",
        "link": "#7ee3e0",
        "link.hover": "#ececec",
        "link.active": "#7ee3e0",
        "list.background": "#121212",
        "list.active.background": "#ffffff1a",
        "list.active.border": "#ffffff1a",
        "list.even.background": "#121212",
        "list.head.background": "#121212",
        "list.hover.background": "#1f1f1f",
        "muted.background": "#262626",
        "muted.foreground": "#a3a3a3",
        "popover.background": "#222222",
        "popover.foreground": "#d9d9d9",
        "primary.background": "#ececec",
        "primary.hover.background": "#d9d9d9",
        "primary.active.background": "#c2c2c2",
        "primary.foreground": "#121212",
        "secondary.background": "#262626",
        "secondary.hover.background": "#2a2a2a",
        "secondary.active.background": "#303030",
        "secondary.foreground": "#d9d9d9",
        "progress.bar.background": "#8b93ff",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#ececec24",
        "scrollbar.thumb.hover.background": "#ececec3d",
        "selection.background": "#8b93ff4c",
        "sidebar.background": "#1a1a1a",
        "sidebar.foreground": "#a3a3a3",
        "sidebar.border": "#ffffff1a",
        "sidebar.accent.background": "#2a2a2a",
        "sidebar.accent.foreground": "#ececec",
        "sidebar.primary.background": "#ececec",
        "sidebar.primary.foreground": "#121212",
        "skeleton.background": "#1f1f1f",
        "switch.background": "#303030",
        "slider.background": "#8b93ff",
        "slider.thumb.background": "#ececec",
        "tab.background": "#00000000",
        "tab.foreground": "#ecececb2",
        "tab.active.background": "#2a2a2a",
        "tab.active.foreground": "#ececec",
        "tab_bar.background": "#00000000",
        "tab_bar.segmented.background": "#1f1f1f",
        "table.background": "#121212",
        "table.head.foreground": "#a3a3a3",
        "table.row.border": "#ffffff0f",
        "title_bar.background": "#1a1a1a",
        "title_bar.border": "#ffffff1a",
        "status_bar.background": "#1a1a1a",
        "status_bar.border": "#ffffff1a",
        "overlay": "#00000099",
        "window.border": "#ffffff1a",
        "description_list.label.background": "#1f1f1f",
        "description_list.label.foreground": "#a3a3a3",
        "base.red": "#ec8b86",
        "base.green": "#7fdcb0",
        "base.blue": "#7ec8ff",
        "base.yellow": "#e6c97e",
        "base.magenta": "#b79cff",
        "base.cyan": "#7ee3e0",
        "base.red.light": "#ec8b86",
        "base.green.light": "#7fdcb0",
        "base.blue.light": "#7ec8ff",
        "base.yellow.light": "#e6c97e",
        "base.magenta.light": "#b79cff",
        "base.cyan.light": "#7ee3e0",
        "chart.1": "#8b93ff",
        "chart.2": "#7ee3e0",
        "chart.3": "#b79cff",
        "chart.4": "#7fdcb0",
        "chart.5": "#e6c97e",
        "chart.bullish": "#7fdcb0",
        "chart.bearish": "#ec8b86",
        "chart.grid": "#ffffff0f"
      },
      "highlight": {
        "editor.foreground": "#d0d0ff",
        "editor.background": "#200020",
        "editor.active_line.background": "#80000040",
        "editor.line_number": "#c080c0",
        "editor.active_line_number": "#d0d0ff",
        "error.border": "#ec8b86",
        "hint": "#404080",
        "syntax": {
          "keyword": {
            "color": "#60b0ff"
          },
          "preproc": {
            "color": "#60b0ff"
          },
          "variable.special": {
            "color": "#008080"
          },
          "constant": {
            "color": "#8080a0"
          },
          "boolean": {
            "color": "#8080a0"
          },
          "number": {
            "color": "#7090b0"
          },
          "string": {
            "color": "#999999"
          },
          "string.regex": {
            "color": "#999999"
          },
          "comment": {
            "color": "#404080",
            "font_style": "italic"
          },
          "variable": {
            "color": "#008080"
          },
          "function": {
            "color": "#008080"
          },
          "property": {
            "color": "#50a0a0"
          },
          "type": {
            "color": "#70e080"
          },
          "constructor": {
            "color": "#70e080"
          },
          "tag": {
            "color": "#009090"
          },
          "attribute": {
            "color": "#d0d0ff"
          },
          "operator": {
            "color": "#a0a0ff"
          },
          "punctuation": {
            "color": "#805080"
          },
          "emphasis": {
            "font_style": "italic"
          },
          "emphasis.strong": {
            "font_weight": 600
          },
          "link_text": {
            "color": "#60b0ff"
          },
          "text.literal": {
            "color": "#999999"
          },
          "title": {
            "color": "#d0d0ff",
            "font_weight": 600
          }
        }
      }
    }
