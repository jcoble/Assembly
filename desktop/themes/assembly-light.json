          },
          "type": {
            "color": "#0b7471"
          },
          "number": {
            "color": "#865f00"
          },
          "constant": {
            "color": "#865f00"
          },
          "boolean": {
            "color": "#865f00"
          },
          "tag": {
            "color": "#6d45c4"
          },
          "attribute": {
            "color": "#0b7471"
          },
          "emphasis": {
            "font_style": "italic"
