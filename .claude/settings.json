{
  "permissions": {
    "deny": [
      "Edit(**/.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/pinned-guard.sh"
          }
        ]
      }
    ]
  }
}
