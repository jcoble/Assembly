{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Assembly",
  "version": "0.1.0",
  "identifier": "dev.jcoble.assembly",
  "build": {
    "frontendDist": "../app/build",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm --dir ../app dev",
    "beforeBuildCommand": "pnpm --dir ../app build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$HOME/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": { "backend/": "backend/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
